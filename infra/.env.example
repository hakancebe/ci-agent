# infra/.env olarak kopyalayıp doldurun (bu dosya git'e girmez).
#   cp infra/.env.example infra/.env

# --- Azure hedefi ---
AZURE_SUBSCRIPTION=""                 # boşsa `az account show` ile aktif olan kullanılır
LOCATION="westeurope"
RG="rg-ciagent"

# ACR adı Azure genelinde BENZERSİZ olmalı, yalnızca küçük harf + rakam (5-50).
ACR_NAME="acrciagent0001"

IDENTITY_NAME="id-ciagent"            # user-assigned managed identity
LAW_NAME="log-ciagent"                # Log Analytics workspace
ACA_ENV="cae-ciagent"                 # Container Apps environment

# --- Mevcut Azure OpenAI kaynağı ---
# Kaynağın tam resource ID'si. Şununla bulunur:
#   az cognitiveservices account list --query "[].{name:name,id:id}" -o table
# Boş bırakılırsa "Cognitive Services OpenAI User" rol ataması ATLANIR
# (Faz 3'te managed identity'ye geçerken şart, Faz 0-2'de key ile de çalışır).
AOAI_RESOURCE_ID=""
