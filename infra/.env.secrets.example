# infra/.env.secrets olarak kopyalayıp doldurun. Bu dosya git'e GİRMEZ.
#   cp infra/.env.secrets.example infra/.env.secrets

# --- GitHub App ---
# App sayfasının üstünde yazan sayı.
GITHUB_APP_ID=""

# "Generate a private key" ile inen .pem dosyasının YOLU (içeriği değil).
# Dosyayı repo dizinine KOYMAYIN; ~/.ssh ya da parola yöneticisi yanında dursun.
GITHUB_APP_PRIVATE_KEY_PATH=""

# App kaydında "Webhook secret" alanına girdiğiniz değer.
GITHUB_WEBHOOK_SECRET=""

# --- Azure OpenAI ---
#   az cognitiveservices account show -n <ad> -g <rg> --query properties.endpoint -o tsv
AZURE_OPENAI_ENDPOINT=""
#   az cognitiveservices account keys list -n <ad> -g <rg> --query key1 -o tsv
AZURE_OPENAI_KEY=""
# Model deployment adı (ör: gpt-4o)
AZURE_OPENAI_DEPLOYMENT=""
