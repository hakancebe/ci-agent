<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CiAgent.Core\CiAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Container Apps Job'ı ARM API üzerinden başlatmak için managed identity
         token'ı gerekiyor. Tam Azure SDK (Azure.ResourceManager.AppContainers)
         yerine sadece Azure.Identity + düz HTTP kullanılıyor: tek bir POST için
         onlarca megabaytlık bir bağımlılık ağacı taşımaya değmiyor. -->
    <PackageReference Include="Azure.Identity" Version="1.13.1" />

    <!-- Uçtan uca izleme. ACA zaten stdout'u Log Analytics'e gönderiyor; bu paket
         onun göremediğini ekliyor: HTTP istekleri, giden bağımlılık çağrıları
         (GitHub API, Azure OpenAI, ARM) ve bunların süreleri/hataları tek bir
         işlem (trace) altında birleşiyor. "Analiz neden 40 saniye sürdü"
         sorusunun cevabı düz log satırlarında yok. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
